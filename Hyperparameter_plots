def two_sig_figs(x, _):
    return f"{x:.2g}"

def process_hyperparameters(file_path, constant_param):
    """
    Extracts the accuracies associated with the varying hyperparameter 
    while keeping one hyperparameter constant, including the best accuracy.
    
    The file is expected to have a training section with the following structure:
      - A line starting with '---SEARCH FOR BEST SPA(s)' followed by a header line:
         "nb_iterations , gamma, include_prev_context, handle_N_setting, ratio, ensemble type, num_threads, time taken, accuracy"
      - Several data rows with corresponding values.
      - A line starting with '---BEST SPA(s) FOUND' followed by a line containing the best hyperparameters in dictionary form.
    
    Args:
        file_path (str): Path to the file to process.
        constant_param (str): The hyperparameter to keep constant (valid options are: 
                              "nb_iterations", "gamma", "include_prev_context", "handle_N_setting", 
                              "ratio", "ensemble_type", or "num_threads").
    
    Returns:
        pd.DataFrame: A DataFrame with the varying hyperparameter, their accuracies, 
                      and the best accuracy.
    """
    import pandas as pd

    with open(file_path, 'r') as file:
        lines = file.readlines()

    # Parse the best hyperparameters and associated accuracy
    best_hp_line = next(line for line in lines if line.startswith("Best hyperparameters:"))
    best_hyperparams = eval(best_hp_line.split(":", 1)[1].strip())
    best_accuracy = best_hyperparams.get("VALIDATION ACCURACY", None)
    if best_accuracy is None:
        raise ValueError("The best hyperparameters line does not contain a valid accuracy value.")

    # Identify the training data section based on markers
    start_marker = "---SEARCH FOR BEST SPA(s)"
    end_marker = "---BEST SPA(s) FOUND"
    try:
        training_data_start = lines.index(start_marker + "\n") + 1  # header line is at this position
    except ValueError:
        raise ValueError("Start marker not found in file.")
    try:
        training_data_end = lines.index(end_marker + "\n")
    except ValueError:
        raise ValueError("End marker not found in file.")

    training_data = [line.strip() for line in lines[training_data_start:training_data_end] if line.strip()]

    # The first line is the header; subsequent lines are data rows
    header = training_data[0]
    # Split header by commas and strip whitespace
    column_names = [col.strip() for col in header.split(",")]
    if len(column_names) != 9:
        # Fallback to hardcoded names if header does not match expectation
        column_names = ["nb_iterations", "gamma", "include_prev_context", "handle_N_setting", "ratio", 
                        "ensemble type", "num_threads", "time taken", "accuracy"]

    # Build DataFrame from data rows (skipping header)
    data = pd.DataFrame(
        [row.split(",") for row in training_data[1:] if len(row.split(",")) == len(column_names)],
        columns=column_names
    )
    # Remove extra whitespace from each cell
    data = data.applymap(lambda x: x.strip() if isinstance(x, str) else x)

    # Convert numeric columns to float
    for col in ["nb_iterations", "gamma", "ratio", "num_threads", "time taken", "accuracy"]:
        data = data[pd.to_numeric(data[col], errors='coerce').notna()]
    data[["nb_iterations", "gamma", "ratio", "num_threads", "time taken", "accuracy"]] = data[["nb_iterations", "gamma", "ratio", "num_threads", "time taken", "accuracy"]].astype(float)
    
    # Convert the boolean column for include_prev_context
    data["include_prev_context"] = data["include_prev_context"].astype(str).str.strip().map({"True": True, "False": False})

    #data["ensemble type"] = data["ensemble type"].map({"depth": 0, "entropy": 1})

    # Mapping from function parameter names to DataFrame column names
    param_to_col_map = {
        "nb_iterations": "nb_iterations",
        "gamma": "gamma",
        "include_prev_context": "include_prev_context",
        "handle_N_setting": "handle_N_setting",
        "ratio": "ratio",
        "ensemble type": "ensemble type",
        "num_threads": "num_threads"
    }

    # Mapping from DataFrame column names to the corresponding keys in best_hyperparams
    hp_key_map = {
        "nb_iterations": "NB_TRAIN_ITERATIONS",
        "gamma": "GAMMA",
        "include_prev_context": "INCLUDE_PREV_CONTEXT",
        "handle_N_setting": "HANDLE_N_SETTING",
        "ratio": "RATIO_PRETRAIN_TRAIN",
        "ensemble type": "ENSEMBLE_TYPE",
        "num_threads": "NUM_THREADS"
    }

    if constant_param not in param_to_col_map:
        raise ValueError(f"Constant parameter '{constant_param}' is not recognized. Valid options are: {list(param_to_col_map.keys())}")

    varying_param_col = param_to_col_map[constant_param]

    # Build filters for all hyperparameters (except the one that's varying)
    filters = []
    for param, col in param_to_col_map.items():
        if col != varying_param_col:
            key = hp_key_map.get(col, None)
            if key and key in best_hyperparams:
                filters.append(data[col] == best_hyperparams[key])

    # Apply each filter sequentially
    constant_data = data
    for f in filters:
        constant_data = constant_data[f]

    # Add the best accuracy column for reference
    constant_data["best_accuracy"] = best_accuracy

    # Return a DataFrame with only the varying hyperparameter, accuracy, and best accuracy
    return constant_data[[varying_param_col, "accuracy", "best_accuracy"]]

def plot_gamma_results_subplots(file_path_groups, constant_param="gamma", plot_type="accuracy", group_titles=None):
    """
    Creates a subplot grid where each subplot corresponds to a group of file paths, 
    and within each subplot, the files in the group are plotted.

    Args:
        file_path_groups (list of lists): List of groups of file paths.
        constant_param (str): Hyperparameter to keep constant (default: 'gamma').
        plot_type (str): Type of plot ('accuracy' or 'error'). Default is 'accuracy'.
        group_titles (list): Titles for each subplot group. Should match the length of file_path_groups.
    """
    num_groups = len(file_path_groups)
    num_cols = 2  # Number of columns in the subplot grid
    num_rows = (num_groups + 1) // num_cols  # Calculate rows dynamically
    filename_to_label = {
    "mouse0.txt": "m0",
    "mouse1.txt": "m1",
    "mouse2.txt": "m2",
    "mouse3.txt": "m3",
    "mouse4.txt": "m4",
    "tf0.txt":"tf0",
    "tf1.txt":"tf1",
    "tf2.txt":"tf2",
    "tf3.txt":"tf3",
    "tf4.txt":"tf4",
    "H3.txt": "H3",
    "H3K4me2.txt": "H3K4me2",
    "H3K9ac.txt": "H3K9ac",
    "H3K14ac.txt": "H3K14ac",
    "H3K36me3.txt": "H3K36me3",
    "H3K4me1.txt": "H3K4me1",
    "H3K4me3.txt": "H3K4me3",
    "H3K79me3.txt": "H3K79me3",
    "H4.txt": "H4",
    "H4ac.txt": "H4ac",
    "prom_300_all.txt": "p300a",
    "prom_300_notata.txt": "p300n",
    "prom_300_tata.txt": "p300t",
    "prom_core_all.txt":"pca",
    "prom_core_tata.txt":"pct",
    "prom_core_notata.txt":"pca",
    "splice.txt":"splice",
    "covid.txt": "Covid"
    }
    # Set up the figure and axes for subplots
    fig, axes = plt.subplots(num_rows, num_cols, figsize=(8, num_rows * 3), constrained_layout=True)
    axes = axes.flatten()  # Flatten for easier indexing
    for i, file_paths in enumerate(file_path_groups):
        ax = axes[i]

        for path in file_paths:
            # Process the file to get gamma vs accuracy
            result_df = process_hyperparameters(path, constant_param)
            result_df = result_df.sort_values(by=constant_param)

            # Select the y-axis data based on plot_type
            if plot_type == "accuracy":
                y_data = result_df["accuracy"]
                y_label = "Validation Accuracy (%)"
            elif plot_type == "error":
                y_data = 100 - result_df["accuracy"]
                y_label = "Error Percentage (%)"
            else:
                raise ValueError("Invalid plot_type. Choose 'accuracy' or 'error'.")

            # Plot the data
            ax.plot(result_df[constant_param], y_data, marker='o', label=filename_to_label.get(path.split("/")[-1]))

        # Add subplot details
        print(group_titles)
        ax.set_title(group_titles[i] if group_titles else f"Group {i+1}", fontsize = 20)
        #ax.set_xlabel(constant_param.capitalize(), fontsize = 16)
        ax.set_xlabel("Number of Iterations", fontsize = 16)
        ax.set_ylabel(y_label, fontsize = 16)
        ax.tick_params(labelsize=16)
        ax.legend(title="Datasets", loc='lower left', bbox_to_anchor=(1.03, 0), fontsize=14, title_fontsize = 16)
        ax.grid(True)

        ax.xaxis.set_major_formatter(FuncFormatter(two_sig_figs))
        ax.yaxis.set_major_formatter(FuncFormatter(two_sig_figs))
    # Turn off unused subplots
    for j in range(len(file_path_groups), len(axes)):
        axes[j].axis('off')

    # Add a main title
    fig.suptitle(f"{y_label} vs Number of Iterations Across Groups for Minimal Sweep", fontsize=26)
    #fig.suptitle(f"{y_label} vs {constant_param.capitalize()} Across Groups for Full Sweep", fontsize=26)
    plt.show()

def plot_accuracy_difference(data):
    """
    Plots accuracy difference vs sequence length with color distinction 
    for positive and negative values and a horizontal line at zero.

    Parameters:
    data (DataFrame): DataFrame containing 'sequence_length' and 'accuracy_difference'
    """
    plt.figure(figsize=(8, 6))

    # Positive values in blue, negative values in red
    plt.scatter(data.loc[data['accuracy_difference'] >= 0, 'sequence_length'],
                data.loc[data['accuracy_difference'] >= 0, 'accuracy_difference'],
                color='blue', alpha=0.7, label='Positive Difference')

    plt.scatter(data.loc[data['accuracy_difference'] < 0, 'sequence_length'],
                data.loc[data['accuracy_difference'] < 0, 'accuracy_difference'],
                color='red', alpha=0.7, label='Negative Difference')

    # Add a dark line at y=0
    plt.axhline(0, color='black', linestyle='--', linewidth=1)

    # Labels and title
    plt.title('Accuracy Difference vs Sequence Length')
    plt.xlabel('Sequence Length')
    plt.ylabel('Accuracy Difference')
    plt.legend()
    plt.grid(True)

    plt.show()

